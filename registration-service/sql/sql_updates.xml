<?xml version="1.0" encoding="UTF-8"?>
<updates>
    <update>
        <table>tbl_registration_service_pending</table>
        <version>1.021</version>
        <description>Record when an administrator last sent a registration reminder.</description>
        <data>
            <add><name>last_reminder_at</name><type>timestamp</type></add>
        </data>
    </update>
    <update>
        <table>tbl_registration_service_pending</table>
        <version>1.004</version>
        <description>Store the normalized international mobile number while registration awaits verification.</description>
        <data>
            <add>
                <name>mobile_number</name>
                <type>text</type>
                <length>16</length>
            </add>
        </data>
    </update>
    <update>
        <table>tbl_registration_service_pending</table>
        <version>1.020</version>
        <description>Retain the identity document type and number during verified registration.</description>
        <data>
            <add><name>identity_document_type</name><type>text</type><length>32</length></add>
            <add><name>identity_document_number</name><type>text</type><length>128</length></add>
        </data>
    </update>
</updates>
